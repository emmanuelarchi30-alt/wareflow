# Backend Environment Variables
PORT=3001
NODE_ENV=development

# Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-anon-key
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Anthropic (Claude Vision)
ANTHROPIC_API_KEY=sk-ant-tu-api-key

# countrystatecity.in
COUNTRY_STATE_CITY_API_KEY=tu-api-key

# Frontend URL (para CORS)
FRONTEND_URL=http://localhost:5173

# Soporte por correo (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-cuenta-de-soporte@gmail.com
SMTP_PASS=tu-clave-de-aplicacion-smtp
SMTP_FROM=tu-cuenta-de-soporte@gmail.com